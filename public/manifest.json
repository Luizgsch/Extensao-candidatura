{
  "manifest_version": 3,
  "name": "Assistente de Candidaturas",
  "version": "0.7.2",
  "description": "Dados, respostas e campos ensinados por site. Recursos novos experimentais; envio manual.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Assistente de Candidaturas — base técnica",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
